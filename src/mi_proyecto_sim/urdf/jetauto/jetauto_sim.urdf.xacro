<?xml version="1.0"?>
<!--
  ===========================================================================
  JetAuto SIMULATION robot (Ignition gz-sim) — sim-to-real of the real JetAuto.
  ===========================================================================
  Built from the REAL robot ground truth (Jetson Orin jetauto_ros2_ws +
  Jetson Nano ROS1 jetauto_ws):
    * geometry / meshes : real jetauto_description (base, 4 mecanum wheels, shells)
    * mecanum wheels    : friction-based with 12 modeled rollers each (no kinematic
                          plugin) -> holonomic strafe emerges from physics
    * sensors           : RPLIDAR A1 (/scan), MPU-6050 IMU (/imu/data_raw), Astra (/cam_1)
    * control           : velocity command on the 4 wheels (ros2_control) driven by
                          jetauto_chassis_sim.py (faithful port of mecanum.py)
    * odom/TF           : odom_raw (dead-reckoning) + madgwick + robot_localization EKF

  Used by launch/jetauto_sim.launch.py.  Model spawned in gz as "jetauto".
-->
<robot name="jetauto" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="prefix"     default=""/>

  <xacro:include filename="$(find mi_proyecto_sim)/urdf/jetauto/jetauto_base.urdf.xacro"/>
  <xacro:include filename="$(find mi_proyecto_sim)/urdf/jetauto/jetauto_mecanum_wheel.urdf.xacro"/>
  <xacro:include filename="$(find mi_proyecto_sim)/urdf/jetauto/jetauto_sensors.urdf.xacro"/>
  <xacro:include filename="$(find mi_proyecto_sim)/urdf/jetauto/jetauto_control.urdf.xacro"/>

  <!-- chassis + decorative shells -->
  <xacro:jetauto_base prefix="$(arg prefix)"/>

  <!-- 4 mecanum wheels (X roller config). Per-corner STL from the real description. -->
  <xacro:jetauto_mecanum_wheel prefix="$(arg prefix)" side="front_left"  mesh="wheel_left_front_link"  x_reflect="1"  y_reflect="1"/>
  <xacro:jetauto_mecanum_wheel prefix="$(arg prefix)" side="front_right" mesh="wheel_right_front_link" x_reflect="1"  y_reflect="-1"/>
  <xacro:jetauto_mecanum_wheel prefix="$(arg prefix)" side="back_left"   mesh="wheel_left_back_link"   x_reflect="-1" y_reflect="1"/>
  <xacro:jetauto_mecanum_wheel prefix="$(arg prefix)" side="back_right"  mesh="wheel_right_back_link"  x_reflect="-1" y_reflect="-1"/>

  <!-- sensors -->
  <xacro:jetauto_sensors prefix="$(arg prefix)"/>

  <!-- velocity ros2_control + ign_ros2_control -->
  <xacro:jetauto_control prefix="$(arg prefix)"/>

  <!-- (Marcador ArUco del techo eliminado: lo usaba el dron para localizar el
       carrito; no se usa en las tareas de KF + mapa de ocupacion.) -->

</robot>
