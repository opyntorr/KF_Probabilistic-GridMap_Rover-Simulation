<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tareas_gazebo</name>
  <version>0.1.0</version>
  <description>Filtro de Kalman continuo + control y mapa de ocupacion probabilistico
    corriendo contra la simulacion Gazebo del JetAuto.</description>
  <maintainer email="a00344869@tec.mx">opyntorr</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <!-- DEP_LAUNCH_RUNTIME (se usan solo al lanzar; ver README) -->
  <exec_depend>mi_proyecto_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
